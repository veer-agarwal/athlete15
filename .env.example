# Copy to .env and fill in. .env is gitignored.

# --- Phase 3: Backups ---
# Path on the large archive drive. assistant.db holds training and injury history
# that exists nowhere else. Leave empty to skip backups.
BACKUP_DIR=

# --- Phase 1: Weather (Open-Meteo needs no key) ---
HOME_LAT=40.7295
HOME_LON=-73.9965
TIMEZONE=America/New_York

# --- Phase 2: Telegram ---
# Create a bot by messaging @BotFather on Telegram, then /newbot
TELEGRAM_BOT_TOKEN=
# Your own chat id — message @userinfobot to get it
TELEGRAM_CHAT_ID=

BRIEF_HOUR=7
BRIEF_MINUTE=0

# --- Phase 4: WHOOP ---
# From developer-dashboard.whoop.com
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:8080/callback

# --- Phase 5: Notion ---
# From notion.so/my-integrations. Remember to share each database with the
# integration via the page's Connections menu — the token alone grants nothing.
NOTION_TOKEN=
NOTION_TASKS_DB_ID=

# --- Phase 6: Ollama ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.3:8b

# --- Phase 7: Athletics ---
ATHLETICS_ICS_URL=
