# Copy to .env and fill in. .env is gitignored.

# --- Phase 3: Backups ---
# Path on the large archive drive. assistant.db holds training and injury history
# that exists nowhere else. Leave empty to skip backups.
BACKUP_DIR=

# --- Phase 1: Weather (Open-Meteo needs no key) ---
HOME_LAT=40.7295
HOME_LON=-73.9965
TIMEZONE=America/New_York

# --- Phase 2: Telegram ---
# Create a bot by messaging @BotFather on Telegram, then /newbot
TELEGRAM_BOT_TOKEN=
# Your own chat id — message @userinfobot to get it
TELEGRAM_CHAT_ID=

BRIEF_HOUR=7
BRIEF_MINUTE=0

# --- Phase 4: WHOOP ---
# From developer-dashboard.whoop.com
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:8080/callback

# --- Phase 5: Notion ---
# From notion.so/my-integrations. Remember to share each database with the
# integration via the page's Connections menu — the token alone grants nothing.
NOTION_TOKEN=
NOTION_TASKS_DB_ID=
# Page to create the coursework database under, for scripts/create_notion_db.py.
# Open the page in Notion, share it with the integration, and take the 32 char id
# out of the URL. Only needed once, when creating the database.
NOTION_PARENT_PAGE_ID=

# --- Phase 6: Ollama ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# Optional faster model for interactive replies later. Empty means use OLLAMA_MODEL.
OLLAMA_MODEL_FAST=

# --- iCloud calendar (CalDAV) ---
# App-specific password from appleid.apple.com -> Sign-In and Security ->
# App-Specific Passwords. NOT the Apple ID password. Note: changing the Apple ID
# password silently revokes every app-specific password.
ICLOUD_USERNAME=
ICLOUD_APP_PASSWORD=
# The only calendar create_event() will write to. Must exist in iCloud already.
ICLOUD_CALENDAR_NAME=athlete15

# --- Phase 7: Athletics ---
ATHLETICS_ICS_URL=
